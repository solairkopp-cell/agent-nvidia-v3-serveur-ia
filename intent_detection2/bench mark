from intent_service import IntentService

service = IntentService()

# (phrase, expected_intent)
tests = [
    # --- start_navigation ---
    ("Take me to the next stop", "start_navigation"),
    ("Let's go", "start_navigation"),
    ("Go", "start_navigation"),
    ("Move out", "start_navigation"),
    ("Hit the road", "start_navigation"),
    ("Get me there", "start_navigation"),
    ("Next delivery now", "start_navigation"),

    # --- show_deliveries ---
    ("What do I have today", "show_deliveries"),
    ("How many stops left", "show_deliveries"),
    ("What's on my plate", "show_deliveries"),
    ("What's left", "show_deliveries"),
    ("Remaining jobs", "show_deliveries"),
    ("Any deliveries left", "show_deliveries"),
    ("What's next on my list", "show_deliveries"),

    # --- get_next_client_name ---
    ("Who's next", "get_next_client_name"),
    ("Who am I delivering to", "get_next_client_name"),
    ("Next person", "get_next_client_name"),
    ("Client name", "get_next_client_name"),
    ("Who is it", "get_next_client_name"),
    ("Who's waiting for me", "get_next_client_name"),
    ("Who is the next guy", "get_next_client_name"),

    # --- get_next_delivery_address ---
    ("Where am I going", "get_next_delivery_address"),
    ("Where to", "get_next_delivery_address"),
    ("Next address", "get_next_delivery_address"),
    ("Where's the next drop", "get_next_delivery_address"),
    ("Destination", "get_next_delivery_address"),
    ("Where do I go next", "get_next_delivery_address"),
    ("Drop off location", "get_next_delivery_address"),

    # --- get_package_info ---
    ("What's in the box", "get_package_info"),
    ("Is it fragile", "get_package_info"),
    ("Heavy or light", "get_package_info"),
    ("Any special care needed", "get_package_info"),
    ("What am I carrying", "get_package_info"),
    ("Package details", "get_package_info"),
    ("Anything special about this one", "get_package_info"),

    # --- get_possible_delivery_failure_reason ---
    ("What if nobody answers", "get_possible_delivery_failure_reason"),
    ("Why would I fail this delivery", "get_possible_delivery_failure_reason"),
    ("What can go wrong", "get_possible_delivery_failure_reason"),
    ("Possible failure reasons", "get_possible_delivery_failure_reason"),
    ("What are my options if I can't deliver", "get_possible_delivery_failure_reason"),
    ("What happens if delivery fails", "get_possible_delivery_failure_reason"),
    ("Reasons for failed delivery", "get_possible_delivery_failure_reason"),

    # --- show_map ---
    ("Map please", "show_map"),
    ("I want to see the map", "show_map"),
    ("Where is it on the map", "show_map"),
    ("Show me visually", "show_map"),
    ("Map view", "show_map"),
    ("Pull up the map", "show_map"),
    ("I need the map", "show_map"),


    # --- AMBIGUOUS / TRICKY ---
    # show_map vs start_navigation
    ("Show me the route", "show_map"),
    ("Take me through the route", "start_navigation"),

    # get_my_address vs get_next_delivery_address
    ("What's the address", "get_my_address"),
    ("What's the delivery address", "get_next_delivery_address"),

    # show_deliveries vs get_next_client_name
    ("Who are my clients today", "show_deliveries"),
    ("Who is my next client", "get_next_client_name"),

    # get_package_info vs get_possible_delivery_failure_reason
    ("Any instructions for this package", "get_package_info"),
    ("Any instructions if I can't deliver", "get_possible_delivery_failure_reason"),
]

# Run
passed = 0
failed = 0
failures = []

for phrase, expected in tests:
    predicted = service.predict(phrase)
    proba = service.predict_proba(phrase)
    confidence = proba[predicted] * 100
    ok = predicted == expected
    if ok:
        passed += 1
    else:
        failed += 1
        failures.append((phrase, expected, predicted, confidence))

# Report
print(f"\n{'='*60}")
print(f"RESULTS: {passed}/{len(tests)} passed ({passed/len(tests)*100:.1f}%)")
print(f"{'='*60}")

if failures:
    print(f"\nFAILURES ({len(failures)}):")
    for phrase, expected, predicted, conf in failures:
        print(f"  ✗ '{phrase}'")
        print(f"    expected  : {expected}")
        print(f"    predicted : {predicted} ({conf:.1f}%)")
else:
    print("\n✓ All tests passed!")